{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend para el Dashboard del Robot Agrícola",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=../../.env src/index.js",
    "dev": "node --watch --env-file=../../.env src/index.js",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit:cov": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageDirectory='coverage/unit'",
    "test:e2e": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.js --runInBand",
    "test:e2e:cov": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.js --runInBand --coverage --coverageDirectory='coverage/e2e'"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@turf/turf": "^7.3.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@testcontainers/postgresql": "^11.14.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "prisma-erd-generator": "^2.4.3",
    "supertest": "^7.2.2"
  }
}
