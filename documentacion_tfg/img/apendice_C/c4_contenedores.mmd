C4Container
    title Diagrama C4 (Nivel 2: Contenedores) - Arquitectura de AgroSkopos

    Person(admin, "Operario Agrícola", "Gestiona y monitoriza misiones mediante el dashboard.")
    
    System_Boundary(c1, "Sistema AgroSkopos (Docker)") {
        Container(spa, "Aplicación Web (SPA)", "React, Vite, Zustand", "Provee el mapa interactivo (GIS) y el panel de control en tiempo real a través del navegador.")
        Container(api, "Servidor API y Simulador", "Node.js, Express, Socket.io", "Gestión de autenticación, validación Zod, lógica de negocio y simulación física/agronómica.")
        ContainerDb(db, "Base de Datos Relacional", "PostgreSQL", "Almacenamiento persistente de telemetría masiva, misiones, credenciales y búferes.")
    }

    Rel(admin, spa, "Visita y opera", "HTTPS")
    Rel(spa, api, "Llamadas API REST (Estático)", "JSON/HTTPS")
    Rel(spa, api, "Suscripción Telemetría (Dinámico)", "WebSockets (WSS)")
    Rel(api, db, "Lee y escribe (Prisma ORM)", "TCP/IP")
