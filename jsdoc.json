{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "source": {
    "include": [
      "./app/server/src",
      "./app/client/src"
    ],
    "includePattern": ".+\\.(js|jsx)$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [
    "plugins/markdown"
  ],
  "opts": {
    "template": "node_modules/clean-jsdoc-theme",
    "encoding": "utf8",
    "destination": "./docs",
    "recurse": true,
    "readme": "./README.md",
    "theme_opts": {
      "default_theme": "dark",
      "title": "Documentación del Robot Agrícola"
    }
  }
}